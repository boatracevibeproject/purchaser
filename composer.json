{
    "name": "bvp/purchaser",
    "description": "BVP Purchaser：舟券を自動購入する PHP ライブラリ | PHP library for purchasing boatrace tickets",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "boatrace",
        "library",
        "purchaser"
    ],
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/boatracevibeproject/purchaser/issues",
        "source": "https://github.com/boatracevibeproject/purchaser"
    },
    "require": {
        "php": "^8.3",
        "php-webdriver/webdriver": "^1.16"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "vimeo/psalm": "^6.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BVP\\Purchaser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\Purchaser\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php vendor/bin/pint"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
